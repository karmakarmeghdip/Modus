// Modus Effects & Error Handling: IO, perform, and check

function read_line(): IO(String) {
    // Platform IO stub
    return IO.pure("");
}

function parse_int(s: String): Result(i32, String) {
    return Result.Ok(42);
}

function query_database(id: i32): IO(Result(String, String)) {
    return IO.pure(Result.Ok("record_data"));
}

function fetch_user_input(): IO(Result(i32, String)) {
    // perform unwraps IO(T)
    let raw: String = perform read_line();
    // check early-returns Err
    let parsed: i32 = check parse_int(raw);
    return Result.Ok(parsed);
}

function process_record(id: i32): IO(Result(String, String)) {
    // check perform runs IO then bubbles Err if Err
    let data: String = check perform query_database(id);
    return Result.Ok(data);
}

function perform_check_order(res_io: Result(IO(String), String)): IO(Result(String, String)) {
    // perform check validates first, skips IO on Err
    let val: String = perform check res_io;
    return Result.Ok(val);
}
