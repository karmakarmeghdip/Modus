// Modus Control Flow: strictly parenthesized if, else if, else, and pure tail recursion

function sign(x: i32): i32 {
    if (x > 0) {
        return 1;
    } else if (x < 0) {
        return -1;
    } else {
        return 0;
    }
}

function clamp(val: f64, min_val: f64, max_val: f64): f64 {
    // If expressions producing a value
    let clamped: f64 = if (val < min_val) {
        min_val
    } else if (val > max_val) {
        max_val
    } else {
        val
    };

    return clamped;
}

// Pure functional iteration via tail recursion (optimized with LLVM musttail)
function countdown(current: i32): i32 {
    if (current <= 0) {
        return 0;
    } else {
        return countdown(current - 1);
    }
}

// Tail recursive accumulator
function sum_range(n: i32, acc: i32): i32 {
    if (n <= 0) {
        return acc;
    } else {
        return sum_range(n - 1, acc + n);
    }
}
