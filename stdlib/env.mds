// Standard Environment Module for Modus (std:env)

export type IOError = {
    code: i32,
    message: String,
};

extern "C" {
    function getenv(name: CString): IO(CString);
    function setenv(name: CString, value: CString, overwrite: i32): IO(i32);
    function unsetenv(name: CString): IO(i32);
    function getcwd(buf: Pointer(u8), size: u64): IO(CString);
    function chdir(path: CString): IO(i32);
    function readlink(pathname: CString, buf: Pointer(u8), bufsiz: u64): IO(i64);
    function malloc(size: u64): IO(Pointer(u8));
    function free(ptr: Pointer(void)): IO(void);
}

/// Retrieves the value of an environment variable.
/// Returns Result.Ok(val) if found, or Result.Err if undefined.
export function getEnv(key: String): IO(Result(String, IOError)) {
    let cs: CString = String.toCString(key);
    let ptr: CString = perform getenv(cs);
    if (ptr.isNull()) {
        return Result.Err({ code: 0, message: "environment variable not found" });
    } else {
        let val: String = perform ptr.toString();
        return Result.Ok(val);
    }
}

/// Sets or updates the value of an environment variable.
export function setEnv(key: String, value: String): IO(Result(void, IOError)) {
    let k: CString = String.toCString(key);
    let v: CString = String.toCString(value);
    let res: i32 = perform setenv(k, v, 1);
    if (res < 0) {
        return Result.Err({ code: res, message: "failed to set environment variable" });
    } else {
        return Result.Ok(());
    }
}

/// Removes an environment variable from the current process environment.
export function removeEnv(key: String): IO(Result(void, IOError)) {
    let k: CString = String.toCString(key);
    let res: i32 = perform unsetenv(k);
    if (res < 0) {
        return Result.Err({ code: res, message: "failed to remove environment variable" });
    } else {
        return Result.Ok(());
    }
}

/// Returns the current working directory of the process.
export function currentDir(): IO(Result(String, IOError)) {
    let buf: Pointer(u8) = perform malloc(4096);
    let res: CString = perform getcwd(buf, 4096);
    if (res.isNull()) {
        perform free(buf.cast());
        return Result.Err({ code: -1, message: "failed to get current working directory" });
    } else {
        let s: String = perform res.toString();
        return Result.Ok(s);
    }
}

/// Changes the current working directory of the process.
export function setCurrentDir(path: String): IO(Result(void, IOError)) {
    let p: CString = String.toCString(path);
    let res: i32 = perform chdir(p);
    if (res < 0) {
        return Result.Err({ code: res, message: "failed to set current working directory" });
    } else {
        return Result.Ok(());
    }
}

/// Returns the system temporary directory path, inspecting TMPDIR, TMP, TEMP, and defaulting to "/tmp".
export function tempDir(): IO(String) {
    let env_tmpdir: Result(String, IOError) = perform getEnv("TMPDIR");
    return match (env_tmpdir) {
        Result.Ok(dir) => dir,
        Result.Err(_) => {
            let env_tmp: Result(String, IOError) = perform getEnv("TMP");
            match (env_tmp) {
                Result.Ok(dir) => dir,
                Result.Err(_) => {
                    let env_temp: Result(String, IOError) = perform getEnv("TEMP");
                    match (env_temp) {
                        Result.Ok(dir) => dir,
                        Result.Err(_) => "/tmp",
                    }
                },
            }
        },
    };
}

/// Returns the canonical path to the currently running executable binary.
export function currentExe(): IO(Result(String, IOError)) {
    let buf: Pointer(u8) = perform malloc(4096);
    let len: i64 = perform readlink(String.toCString("/proc/self/exe"), buf, 4095);
    if (len < 0) {
        perform free(buf.cast());
        return Result.Err({ code: -1, message: "failed to read executable path" });
    } else {
        perform buf.offset(len).write(0);
        let s: String = perform buf.toString();
        return Result.Ok(s);
    }
}
