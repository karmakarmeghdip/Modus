// Standard String Module for Modus (std:string)

extern "C" {
    function strlen(s: CString): i64;
    function strndup(s: CString, n: i64): String;
    function strdup(s: CString): String;
    function strtoll(nptr: CString, endptr: Pointer(void), base: i32): i64;
    function strtod(nptr: CString, endptr: Pointer(void)): f64;
    function modus_str_split(s: CString, delim: CString): [String];
}

// 1. Inspection & Element Access
export function length(s: String): i64 => s.length();
export function charCodeAt(s: String, index: i64): i32 => s.charCodeAt(index);
export function codePointAt(s: String, index: i64): i32 => s.charCodeAt(index);
export function isEmpty(s: String): bool => s.length() == 0;

// 2. Substrings & Slices
export function substring(s: String, start: i64, end: i64): String {
    let s_len: i64 = s.length();
    let st: i64 = if (start < 0) { 0 } else if (start > s_len) { s_len } else { start };
    let en: i64 = if (end < 0) { 0 } else if (end > s_len) { s_len } else { end };
    let actual_start: i64 = if (st > en) { en } else { st };
    let actual_end: i64 = if (st > en) { st } else { en };
    let len: i64 = actual_end - actual_start;
    if (len <= 0) {
        return "";
    } else {
        let s_cs: CString = String.toCString(s);
        return strndup(s_cs.offset(actual_start), len);
    }
}

export function slice(s: String, start: i64, end: i64): String {
    let s_len: i64 = s.length();
    let st: i64 = if (start < 0) {
        let r: i64 = s_len + start;
        if (r < 0) { 0 } else { r }
    } else if (start > s_len) {
        s_len
    } else {
        start
    };
    let en: i64 = if (end < 0) {
        let r: i64 = s_len + end;
        if (r < 0) { 0 } else { r }
    } else if (end > s_len) {
        s_len
    } else {
        end
    };
    if (st >= en) {
        return "";
    } else {
        let len: i64 = en - st;
        let s_cs: CString = String.toCString(s);
        return strndup(s_cs.offset(st), len);
    }
}

export function substr(s: String, start: i64, length: i64): String {
    if (length <= 0) {
        return "";
    } else {
        let s_len: i64 = s.length();
        let st: i64 = if (start < 0) {
            let r: i64 = s_len + start;
            if (r < 0) { 0 } else { r }
        } else {
            start
        };
        return substring(s, st, st + length);
    }
}

export function charAt(s: String, index: i64): String {
    if (index < 0 || index >= s.length()) {
        return "";
    } else {
        return substring(s, index, index + 1);
    }
}

// 3. Search & Matching
function match_at(s: String, search: String, s_idx: i64, search_idx: i64, search_len: i64): bool {
    if (search_idx >= search_len) {
        return true;
    } else if (s.charCodeAt(s_idx + search_idx) != search.charCodeAt(search_idx)) {
        return false;
    } else {
        return match_at(s, search, s_idx, search_idx + 1, search_len);
    }
}

function index_of_loop(s: String, search: String, s_idx: i64, max_idx: i64, search_len: i64): i64 {
    if (s_idx > max_idx) {
        return -1;
    } else if (match_at(s, search, s_idx, 0, search_len)) {
        return s_idx;
    } else {
        return index_of_loop(s, search, s_idx + 1, max_idx, search_len);
    }
}

export function indexOfFrom(s: String, search: String, fromIndex: i64): i64 {
    let s_len: i64 = s.length();
    let search_len: i64 = search.length();
    let start: i64 = if (fromIndex < 0) { 0 } else { fromIndex };
    if (search_len == 0) {
        if (start > s_len) {
            return s_len;
        } else {
            return start;
        }
    } else if (start > s_len - search_len) {
        return -1;
    } else {
        return index_of_loop(s, search, start, s_len - search_len, search_len);
    }
}

export function indexOf(s: String, search: String): i64 => indexOfFrom(s, search, 0);

function last_index_of_loop(s: String, search: String, idx: i64, search_len: i64): i64 {
    if (idx < 0) {
        return -1;
    } else if (match_at(s, search, idx, 0, search_len)) {
        return idx;
    } else {
        return last_index_of_loop(s, search, idx - 1, search_len);
    }
}

export function lastIndexOfFrom(s: String, search: String, fromIndex: i64): i64 {
    let s_len: i64 = s.length();
    let search_len: i64 = search.length();
    if (search_len == 0) {
        if (fromIndex < 0) {
            return 0;
        } else if (fromIndex > s_len) {
            return s_len;
        } else {
            return fromIndex;
        }
    } else {
        let max_start: i64 = s_len - search_len;
        let start: i64 = if (fromIndex > max_start) { max_start } else { fromIndex };
        return last_index_of_loop(s, search, start, search_len);
    }
}

export function lastIndexOf(s: String, search: String): i64 => lastIndexOfFrom(s, search, s.length() - 1);

function match_prefix_loop(s: String, prefix: String, s_pos: i64, p_idx: i64, p_len: i64): bool {
    if (p_idx >= p_len) {
        return true;
    } else if (s.charCodeAt(s_pos + p_idx) != prefix.charCodeAt(p_idx)) {
        return false;
    } else {
        return match_prefix_loop(s, prefix, s_pos, p_idx + 1, p_len);
    }
}

export function startsWithFrom(s: String, prefix: String, position: i64): bool {
    let s_len: i64 = s.length();
    let p_len: i64 = prefix.length();
    let pos: i64 = if (position < 0) { 0 } else { position };
    if (pos + p_len > s_len) {
        return false;
    } else if (p_len == 0) {
        return true;
    } else {
        return match_prefix_loop(s, prefix, pos, 0, p_len);
    }
}

export function startsWith(s: String, prefix: String): bool => startsWithFrom(s, prefix, 0);

export function endsWith(s: String, suffix: String): bool {
    let s_len: i64 = s.length();
    let suf_len: i64 = suffix.length();
    if (suf_len > s_len) {
        return false;
    } else if (suf_len == 0) {
        return true;
    } else {
        return match_prefix_loop(s, suffix, s_len - suf_len, 0, suf_len);
    }
}

export function includes(s: String, search: String): bool => indexOf(s, search) >= 0;
export function contains(s: String, search: String): bool => indexOf(s, search) >= 0;

// 4. Replacement
export function replace(s: String, search: String, replacement: String): String {
    let idx: i64 = indexOf(s, search);
    if (idx < 0) {
        return s;
    } else {
        let prefix: String = substring(s, 0, idx);
        let suffix: String = substring(s, idx + search.length(), s.length());
        return prefix + replacement + suffix;
    }
}

function replace_all_loop(s: String, search: String, replacement: String, search_len: i64, from_idx: i64, acc: String): String {
    let idx: i64 = indexOfFrom(s, search, from_idx);
    if (idx < 0) {
        return acc + substring(s, from_idx, s.length());
    } else {
        let chunk: String = substring(s, from_idx, idx);
        let next_acc: String = acc + chunk + replacement;
        let next_from: i64 = if (search_len == 0) { idx + 1 } else { idx + search_len };
        if (next_from > s.length()) {
            return next_acc;
        } else {
            return replace_all_loop(s, search, replacement, search_len, next_from, next_acc);
        }
    }
}

export function replaceAll(s: String, search: String, replacement: String): String {
    let search_len: i64 = search.length();
    if (search_len == 0) {
        return replace(s, search, replacement);
    } else {
        return replace_all_loop(s, search, replacement, search_len, 0, "");
    }
}

// 5. Repeat & Padding
function repeat_loop(s: String, count: i64, acc: String): String {
    if (count <= 0) {
        return acc;
    } else {
        return repeat_loop(s, count - 1, acc + s);
    }
}

export function repeat(s: String, count: i64): String {
    if (count <= 0) {
        return "";
    } else {
        return repeat_loop(s, count, "");
    }
}

export function padStart(s: String, targetLength: i64, padString: String): String {
    let s_len: i64 = s.length();
    if (s_len >= targetLength) {
        return s;
    } else {
        let pad_len: i64 = padString.length();
        let pad_str: String = if (pad_len == 0) { " " } else { padString };
        let diff: i64 = targetLength - s_len;
        let repeat_count: i64 = diff / pad_str.length() + 1;
        let full_pad: String = repeat(pad_str, repeat_count);
        let trimmed_pad: String = substring(full_pad, 0, diff);
        return trimmed_pad + s;
    }
}

export function padEnd(s: String, targetLength: i64, padString: String): String {
    let s_len: i64 = s.length();
    if (s_len >= targetLength) {
        return s;
    } else {
        let pad_len: i64 = padString.length();
        let pad_str: String = if (pad_len == 0) { " " } else { padString };
        let diff: i64 = targetLength - s_len;
        let repeat_count: i64 = diff / pad_str.length() + 1;
        let full_pad: String = repeat(pad_str, repeat_count);
        let trimmed_pad: String = substring(full_pad, 0, diff);
        return s + trimmed_pad;
    }
}

// 6. Trimming & Case Conversion
function is_whitespace(code: i32): bool {
    return code == 32 || code == 9 || code == 10 || code == 13;
}

function find_first_non_ws(s: String, len: i64, idx: i64): i64 {
    if (idx >= len) {
        return len;
    } else if (is_whitespace(s.charCodeAt(idx))) {
        return find_first_non_ws(s, len, idx + 1);
    } else {
        return idx;
    }
}

function find_last_non_ws(s: String, idx: i64): i64 {
    if (idx < 0) {
        return -1;
    } else if (is_whitespace(s.charCodeAt(idx))) {
        return find_last_non_ws(s, idx - 1);
    } else {
        return idx;
    }
}

export function trimStart(s: String): String {
    let len: i64 = s.length();
    let start: i64 = find_first_non_ws(s, len, 0);
    return substring(s, start, len);
}

export function trimLeft(s: String): String => trimStart(s);

export function trimEnd(s: String): String {
    let len: i64 = s.length();
    let end: i64 = find_last_non_ws(s, len - 1);
    return substring(s, 0, end + 1);
}

export function trimRight(s: String): String => trimEnd(s);

export function trim(s: String): String {
    let len: i64 = s.length();
    let start: i64 = find_first_non_ws(s, len, 0);
    let end: i64 = find_last_non_ws(s, len - 1);
    if (start > end) {
        return "";
    } else {
        return substring(s, start, end + 1);
    }
}

function find_char_idx(alphabet: String, target_code: i32, idx: i64): i64 {
    if (idx >= alphabet.length()) {
        return -1;
    } else if (alphabet.charCodeAt(idx) == target_code) {
        return idx;
    } else {
        return find_char_idx(alphabet, target_code, idx + 1);
    }
}

function to_lower_char(c: i32, s: String, idx: i64): String {
    let upper_alpha: String = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
    let found: i64 = find_char_idx(upper_alpha, c, 0);
    if (found >= 0) {
        let lower_alpha: String = "abcdefghijklmnopqrstuvwxyz";
        return charAt(lower_alpha, found);
    } else {
        return charAt(s, idx);
    }
}

function to_lower_loop(s: String, idx: i64, len: i64, acc: String): String {
    if (idx >= len) {
        return acc;
    } else {
        let ch: String = to_lower_char(s.charCodeAt(idx), s, idx);
        return to_lower_loop(s, idx + 1, len, acc + ch);
    }
}

export function toLowerCase(s: String): String => to_lower_loop(s, 0, s.length(), "");

function to_upper_char(c: i32, s: String, idx: i64): String {
    let lower_alpha: String = "abcdefghijklmnopqrstuvwxyz";
    let found: i64 = find_char_idx(lower_alpha, c, 0);
    if (found >= 0) {
        let upper_alpha: String = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
        return charAt(upper_alpha, found);
    } else {
        return charAt(s, idx);
    }
}

function to_upper_loop(s: String, idx: i64, len: i64, acc: String): String {
    if (idx >= len) {
        return acc;
    } else {
        let ch: String = to_upper_char(s.charCodeAt(idx), s, idx);
        return to_upper_loop(s, idx + 1, len, acc + ch);
    }
}

export function toUpperCase(s: String): String => to_upper_loop(s, 0, s.length(), "");

// 7. Splitting & Joining
export function split(s: String, delimiter: String): [String] => modus_str_split(String.toCString(s), String.toCString(delimiter));

function join_loop(parts: [String], delimiter: String, len: i64, idx: i64, acc: String): String {
    if (idx >= len) {
        return acc;
    } else if (idx == 0) {
        return join_loop(parts, delimiter, len, idx + 1, parts[idx]);
    } else {
        return join_loop(parts, delimiter, len, idx + 1, acc + delimiter + parts[idx]);
    }
}

export function join(parts: [String], delimiter: String): String {
    let len: i64 = parts.length();
    if (len == 0) {
        return "";
    } else {
        return join_loop(parts, delimiter, len, 0, "");
    }
}

export function concat(s1: String, s2: String): String => s1 + s2;

// 8. Parsing & Construction
function is_digit(c: i32): bool => c >= 48 && c <= 57;

function has_digits(s: String, idx: i64, len: i64, found_any: bool): bool {
    if (idx >= len) {
        return found_any;
    } else {
        let c: i32 = s.charCodeAt(idx);
        if (is_digit(c)) {
            return has_digits(s, idx + 1, len, true);
        } else {
            return false;
        }
    }
}

export function parseInt(s: String): Result(i64, String) {
    let trimmed: String = trim(s);
    let len: i64 = trimmed.length();
    if (len == 0) {
        return Result.Err("Cannot parse empty string as integer");
    } else {
        let first_char: i32 = trimmed.charCodeAt(0);
        let start_idx: i64 = if (first_char == 43 || first_char == 45) { 1 } else { 0 }; // '+' or '-'
        if (has_digits(trimmed, start_idx, len, false)) {
            let cs: CString = String.toCString(trimmed);
            let null_ptr: Pointer(void) = Pointer.null();
            let val: i64 = strtoll(cs, null_ptr, 10);
            return Result.Ok(val);
        } else {
            return Result.Err("Invalid integer format");
        }
    }
}

export function parseIntRadix(s: String, radix: i32): Result(i64, String) {
    let trimmed: String = trim(s);
    let len: i64 = trimmed.length();
    if (len == 0) {
        return Result.Err("Cannot parse empty string as integer");
    } else if (radix < 2 || radix > 36) {
        return Result.Err("Radix out of range (2-36)");
    } else {
        let cs: CString = String.toCString(trimmed);
        let null_ptr: Pointer(void) = Pointer.null();
        let val: i64 = strtoll(cs, null_ptr, radix);
        return Result.Ok(val);
    }
}

export function parseFloat(s: String): Result(f64, String) {
    let trimmed: String = trim(s);
    let len: i64 = trimmed.length();
    if (len == 0) {
        return Result.Err("Cannot parse empty string as float");
    } else {
        let cs: CString = String.toCString(trimmed);
        let null_ptr: Pointer(void) = Pointer.null();
        let val: f64 = strtod(cs, null_ptr);
        return Result.Ok(val);
    }
}

function find_char_by_code(s: String, idx: i64, target_code: i32): String {
    if (idx >= s.length()) {
        return "";
    } else if (s.charCodeAt(idx) == target_code) {
        return charAt(s, idx);
    } else {
        return find_char_by_code(s, idx + 1, target_code);
    }
}

function ascii_char_at(code: i32): String {
    if (code == 10) {
        return "\n";
    } else if (code == 13) {
        return "\r";
    } else if (code == 9) {
        return "\t";
    } else {
        let printable: String = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~";
        return find_char_by_code(printable, 0, code);
    }
}

export function fromCharCode(code: i32): String => ascii_char_at(code);
