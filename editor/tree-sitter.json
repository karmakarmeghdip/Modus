{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "modus",
      "camelcase": "Modus",
      "scope": "source.modus",
      "file-types": [
        "mds"
      ],
      "injection-regex": "^modus$"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Tree-sitter grammar for the Modus programming language",
    "authors": [
      {
        "name": "Modus Authors"
      }
    ],
    "links": {
      "repository": "https://github.com/modus-lang/modus"
    }
  }
}
